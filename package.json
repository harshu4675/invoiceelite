{
  "name": "invoiceelite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch --env-file=.env server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "start": "node --env-file=.env server/index.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "seed": "node --env-file=.env server/seed.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "format": "prettier --write \"{server,shared,client/src,tests}/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"{server,shared,client/src,tests}/**/*.{js,jsx,css}\"",
    "reset-password": "node --env-file=.env server/reset-password.js",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^11.3.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
