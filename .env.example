NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/invoiceelite?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
BUSINESS_NAME=Elite Apprenticeship Services
BUSINESS_ADDRESS=Configure your registered billing address
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Set only behind one trusted reverse proxy; backend must not be publicly bypassable.
TRUST_PROXY=0
